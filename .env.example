# OpenCode Model Configuration (optional - uses OpenCode default if unset)
OPENCODE_MODEL=
OPENCODE_VARIANT=

# Controller Loop Limits
MAX_ITERATIONS=30
MAX_RUNTIME_SECONDS=14400
MAX_STUCK_ITERATIONS=3
TEST_TIMEOUT_SECONDS=1800

# Optional Server & Execution Settings
USE_PERSISTENT_SERVER=false
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_AUTO_APPROVE=true
