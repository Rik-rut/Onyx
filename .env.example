# OpenCode Worker Model Configuration (optional - uses OpenCode default if unset)
OPENCODE_MODEL=opencode/fledge-alpha-free
OPENCODE_VARIANT=high

# Optional independent orchestrator/reviewer via model switch.
# The worker builds with OPENCODE_MODEL; the orchestrator reviews with
# ORCHESTRATOR_MODEL via the same `opencode run` CLI (no API call or key needed).
ORCHESTRATOR_MODEL=
ORCHESTRATOR_VARIANT=

# Controller Loop Limits
MAX_ITERATIONS=30
MAX_RUNTIME_SECONDS=28800
MAX_STUCK_ITERATIONS=3
TEST_TIMEOUT_SECONDS=1800

# Optional Server & Execution Settings
USE_PERSISTENT_SERVER=false
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_AUTO_APPROVE=true

# Optional Verification Settings
TEST_COMMAND=
