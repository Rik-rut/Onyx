{
  "name": "onyx-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Onyx web dashboard SPA (Vite + Svelte 5 + TypeScript + Tailwind CSS v4)",
  "scripts": {
    "dev": "node scripts/dev-proxy.mjs",
    "build": "vite build && node scripts/finalize.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --output human",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/svelte": "^5",
    "http-proxy": "^1.18.1",
    "jsdom": "^25",
    "svelte": "^5",
    "svelte-check": "^4",
    "svelte-preprocess": "^6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
